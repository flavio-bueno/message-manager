  "description": "Uma biblioteca TypeScript para gerenciamento padronizado de mensagens.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
